# Salary slip email (Gmail) — use App Password, not your normal Gmail password
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
# College networks often block port 587; 465 + SSL works (default below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=false
# SMTP_FROM=HRMS Payroll <your@gmail.com>

# Extra password for Admin → Manage Salary (default: chethan if unset)
SALARY_ACCESS_PASSWORD=chethan

# Flask session + CSRF signing (set a long random string in production)
# SECRET_KEY=change-me-to-a-long-random-string
